@using YSN2017.ComLIB
@using System.Collections
@{
    ViewBag.Title = "Home Page";
}


<script src="~/Content/Scripts/jquery-1.10.2.min.js"></script>






<div class="row">
    <div class="col-md-4">
        AuthTest :[ @User.Identity.Name.Split('|')[0] ] [ @User.IsInRole("Admin") ]<br />
        <form name="dataForm" action="/Member/LoginCheck" method="post">
            <input type="text" id="user_cd" name="user_cd" value="12061801" /> <input type="text" id="pass_wd" name="pass_wd" value="0000" /><br />
            <button type="submit" name="Login">[LogIn]</button>
            <a href="/Member/LogOut">[LoOut]</a>
        </form>

        <br />

        @if (User.Identity.IsAuthenticated) {

            <text>user_id     : </text> @User.Identity.Name.Split('|')[0].ToString(); <br />
            <text>user_nm     : </text> @User.Identity.Name.Split('|')[1].ToString(); <br />
            <text>company_cd  : </text> @User.Identity.Name.Split('|')[2].ToString(); <br />
            <text>lang        : </text> @User.Identity.Name.Split('|')[3].ToString(); <br />
            <text>dept_cd     : </text> @User.Identity.Name.Split('|')[4].ToString();

}


    </div>
</div>
