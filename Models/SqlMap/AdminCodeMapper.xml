  <statements>



    <!-- 코드관리 : 상위코드 조회 리스트 -->
    <select id="AdminupCodeList" parameterClass="Hashtable"	resultClass="Hashtable">

      SELECT
      CODE_ID
      ,CODE_ID AS PREID
      , CODE_NM
      , CODE_KOR
      , CODE_ENG
      , CODE_CHN
      , CODE_JPN
      , CODE_LEVEL
      , CODE_ORDER
      , UP_CODE_ID
      , VALUE_1
      , VALUE_2
      , VALUE_3
      , VALUE_4
      , VALUE_5
      , CODE_DESCRIPT
      , USE_YN
      , REG_DT
      , REG_USR
      , MOD_DT
      , MOD_USR
      ,(SELECT COUNT(*) FROM T_CODE WHERE UP_CODE_ID = A.CODE_ID) AS CHILD_CNT
      FROM T_CODE A
      WHERE 1=1
      <isNotEmpty property="searchCodeId">
        AND A.CODE_ID LIKE '%' + #searchCodeId# + '%'
      </isNotEmpty>
      <isNotEmpty property="CodeId">
        AND A.CODE_ID = #CodeId#
      </isNotEmpty>
      <isNotEmpty property="upCodeId">
        AND A.UP_CODE_ID = #upCodeId#
      </isNotEmpty>

      <isNotEmpty property="searchCodeNm">
        AND A.CODE_KOR LIKE '%' + #searchCodeNm#  + '%'
      </isNotEmpty>
      <isNotEmpty property="searchLevel">
        AND A.CODE_LEVEL = #searchLevel#
      </isNotEmpty>
      <isNotEmpty property="searchPreCodeId">
        AND A.Code_ID != #searchPreCodeId#
      </isNotEmpty>

    </select>

    
    
    
    
    
    <!-- 코드관리 : 하위코드 조회 리스트  -->
    <select id="AdmindownCodeList" parameterClass="Hashtable"	resultClass="Hashtable">

      SELECT
      'S' AS MODE
      , CODE_ID
      , CODE_NM
      , CODE_KOR
      , CODE_ENG
      , CODE_CHN
      , CODE_JPN
      , CODE_LEVEL
      , CODE_ORDER
      , UP_CODE_ID
      , VALUE_1
      , VALUE_2
      , VALUE_3
      , VALUE_4
      , VALUE_5
      , CODE_DESCRIPT
      , USE_YN
      , REG_DT
      , REG_USR
      , MOD_DT
      , MOD_USR
      , CODE_ID AS PRE_CODE_ID
      FROM T_CODE
      WHERE 1=1
      <isNotEmpty property="upCodeId">
        AND UP_CODE_ID = #upCodeId#
      </isNotEmpty>


    </select>




    <!-- 코드관리 : 코드 등록  -->
    <insert id="AdmininsertCode" parameterClass="Hashtable"	>

      INSERT INTO T_CODE (
      CODE_ID
      , CODE_NM
      , CODE_KOR
      , CODE_ENG
      , CODE_CHN
      , CODE_JPN
      , CODE_LEVEL
      , CODE_ORDER
      , UP_CODE_ID
      , VALUE_1
      , VALUE_2
      , VALUE_3
      , VALUE_4
      , VALUE_5
      , CODE_DESCRIPT
      , USE_YN
      , REG_DT
      , REG_USR
      , MOD_DT
      , MOD_USR
      ) VALUES (
      #codeId#
      ,#codeNm#
      ,#codeKor#
      ,#codeEng#
      ,#codeChn#
      ,#codeJpn#
      ,#codeLevel#
      ,#codeOrder#
      ,#upCodeId#
      ,#value1#
      ,#value2#
      ,#value3#
      ,#value4#
      ,#value5#
      ,#codeDescript#
      ,#useYn#
      ,GETDATE()
      ,#regUsr#
      ,GETDATE()
      ,#modUsr#
      )

    </insert>
    
    
    
    <!-- 코드관리 : 코드 수정 -->
    <update id="AdminupdateCode" parameterClass="Hashtable">

      UPDATE T_CODE SET
          CODE_ID = #codeId#,
          CODE_NM = #codeNm#,
          CODE_KOR = #codeKor#,
          CODE_ENG = #codeEng#,
          CODE_CHN = #codeChn#,
          CODE_JPN = #codeJpn#,
          CODE_LEVEL = #codeLevel#,
          CODE_ORDER = #codeOrder#,
          UP_CODE_ID = #upCodeId#,
          VALUE_1 = #value1#,
          VALUE_2 = #value2#,
          VALUE_3 = #value3#,
          VALUE_4 = #value4#,
          VALUE_5 = #value5#,
          CODE_DESCRIPT = #codeDescript#,
          USE_YN = #useYn#,
          MOD_DT = GETDATE(),
          MOD_USR = #modUsr#
      WHERE CODE_ID = #preCodeId#
      AND UP_CODE_ID = #upCodeId#
    </update>







