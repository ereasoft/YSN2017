{
    /**
     * The application's namespace.
     애플리케이션의 네임스페이스
     */
    "name": "Ysn",
    
    /**
     * The version of the application.
     애플리케이션의 버전
     */
    "version": "1.0.0.0",

    /**
     * The relative path to the application's markup file (html, jsp, asp, etc.).
     애플리케이션의 마크업 파일(html, jsp, asp, etc.)의 상대 경로
     */
    "indexHtmlPath": "index.aspx",

    /**
     * Comma-separated string with the paths of directories or files to search. Any classes
     * declared in these locations will be available in your class "requires" or in calls
     * to "Ext.require". The "app.dir" variable below is expanded to the path where the
     * application resides (the same folder in which this file is located).
     찾고자 하는 디렉토리나 파일의 경로들을 콤마로 구분하여 문자열을 지정한다.
     지정된 경로에 선언된 클래스들은 사용자 클래스 내부에서 "requires"나 "Ext.require"를 사용하여 활용 가능하다.
     "app.dir" 변수는 애플리케이션이 상주하는 경로로 확장된다. (이 파일(app.json)이 있는 동일한 폴더)
     */
    "classpath": [
        "app",
        "${toolkit.name}/src" 
    ],

    /**
     * Comma-separated string with the paths of directories or files to search. Any classes
     * declared in these locations will be automatically required and included in the build.
     찾고자 하는 디렉토리나 파일들의 경로.
     이곳에 위치한 클래스들은 자동으로 요구되고 빌드에 포함된다.
     * If any file defines an Ext JS override (using Ext.define with an "override" property),
     * that override will in fact only be included in the build if the target class specified
     * in the "override" property is also included.
     Ext.define 할 때 "override" 속성을 사용해서 명시한 대상 클래스들도 빌드에 포함시킨다.
     */
    "overrides": [
        "overrides",
        "${toolkit.name}/overrides"
    ],

    /**
     * The Sencha Framework for this application: "ext" or "touch".
     애플리케이션을 위한 센차 프레임워크 : "ext" 또는 "touch"
     */
    "framework": "ext",
    
    /**
     * The toolkit to use. Select either "classic" or "modern".
     사용하기 위한 툴킷. : "classic" 또는 "modern"을 선택한다.
     */
    
    
    /**
     * The name of the theme for this application.
     애플리케이션 테마의 이름
     */
    "theme": "",
    /**
     * The list of required packages (with optional versions; default is "latest").
     요구되는 패키지 목록 (선택 버전들; 기본은 "latest") : app\ext\packages 디렉토리의 하위 패키지들.
     *
     * For example,
     예를들어,
     *
     *      "requires": [
     *          "charts"
     *      ]
     */
  "requires": [
    "font-awesome",
    "bryntum-calendar",
    "bryntum-scheduler",
    "charts",
    "core"
  ], 
    /**
     * Fashion build configuration properties.
     패션 빌드 설정 속성들
     */
    "fashion": {
        "inliner": {
            /**
             * Disable resource inliner. Production builds enable this by default.
	     inliner 리소스를 비활성화한다. 프로덕션 빌드는 기본으로 이 값이 활성화된다.
             */
            "enable": false
        }
    },

    /**
     * Sass configuration properties.
     사스 설정 속성들
     */
    "sass": {
        /**
         * The root namespace to use when mapping *.scss files to classes in the
         * sass/src and sass/var directories. 
	 sass/src와 sass/var 디렉토리 안에 모든 "*.scss" 파일들을 맵핑할 때 사용하기 위한 루트 네임스페이스
	 * For example, "App.view.Foo" would
         * map to "sass/src/view/Foo.scss". 
	 * If we changed this to "App.view" then
         * it would map to "sass/src/Foo.scss". 
	 예를들어, "App.view.Foo"를 "sass/src/view/Foo.scss"로 맵핑하려면 "App.view"로 지정하한다.
	 * To style classes outside the app's
         * root namespace, change this to "". Doing so would change the mapping of
         * "App.view.Foo" to "sass/src/App/view/Foo.scss".
	 "App.view.Foo"를 "sass/src/App/view/Foo.scss"로 매핑하려면 빈문자("")로 지정한다.
         */
        "namespace": "Ysn",

        /**
         * File used to save sass variables edited via Sencha Inspector. This file
         * will automatically be applied to the end of the scss build.
	 센차 인스팩터를 통해 수정된 사스 변수들을 저장하기 위해 사용되는 파일.
	 이 파일은 자동으로 사스 빌드의 끝에 적용된다.
         *
         *      "save": "sass/save.scss"
         *
         */
         
        /**
         * Comma-separated list of files or folders containing extra Sass. These
         * files are automatically included in the Sass compilation. By default this
         * is just "etc/all.scss" to allow import directives to control the order
         * other files are included.
	 컴파일에 포함시키고자 하는 외부 사스 파일들이나 폴더 목록.
	 이 파일들은 사스 컴파일에 자동으로 포함된다.
	 "etc/all.scss" 파일은 포함된 다른 파일들의 순서를 제어하는 디렉티브를 가져오도록하는데,
	 기본으로 지정된다.
         *
         * All "etc" files are included at the top of the Sass compilation in their
         * dependency order:
	 모든 "etc" 파일들은 사스 컴파일 순서에서 최상위에 포함된다.
         *
         *      +-------+---------+
         *      |       | base    |
         *      | theme +---------+
         *      |       | derived |
         *      +-------+---------+
         *      | packages        |  (in package dependency order)
         *      +-----------------+
         *      | application     |
         *      +-----------------+
         */
        "etc": [
            "sass/etc/all.scss",
            "${toolkit.name}/sass/etc/all.scss"
        ],

        /**
         * Comma-separated list of folders containing Sass variable definitions
         * files. These file can also define Sass mixins for use by components.
	 사스 변수 정의를 포함하는 폴더 목록.
	 이 파일은 컴포넌트에서 사용하도록 사스 믹스인을 정의할 수 있다.
         *
         * All "var" files are included after "etc" files in the Sass compilation in
         * dependency order:
	 모든 "var" 파일들은 사스 컴파일 순서에서 "etc" 파일들 이후에 포함된다.
         *
         *      +-------+---------+
         *      |       | base    |
         *      | theme +---------+
         *      |       | derived |
         *      +-------+---------+
         *      | packages        |  (in package dependency order)
         *      +-----------------+
         *      | application     |
         *      +-----------------+
         *
         * The "sass/var/all.scss" file is always included at the start of the var
         * block before any files associated with JavaScript classes.
	 "sass/var/all.scss" 파일은 언제나 자바스크립트 클래스들과 연결되기 전에 시작 시점에 포함된다.
         */
        "var": [
            "sass/var/all.scss",
            "sass/var",
            "${toolkit.name}/sass/var"
        ],

        /**
         * Comma-separated list of folders containing Sass rule files.
	 사스 룰 파일들을 포함하는 폴더 목록.
         *
         * All "src" files are included after "var" files in the Sass compilation in
         * dependency order (the same order as "etc"):
	 모든 "src" 파일들은 사스 컴파일 순서에서 "var" 파일들 이후에 포함된다. ("etc"와 동일 순서)
         *
         *      +-------+---------+
         *      |       | base    |
         *      | theme +---------+
         *      |       | derived |
         *      +-------+---------+
         *      | packages        |  (in package dependency order)
         *      +-----------------+
         *      | application     |
         *      +-----------------+
         */
        "src": [
            "sass/src",
            "${toolkit.name}/sass/src"
        ]
    },

    /**
     * List of all JavaScript assets in the right execution order.
     자바스크립트 어셋 목록
     *
     * Each item is an object with the following format:
     각 항목은 다음의 형태와 같은 객체이다.
     *
     *      {
     *          // Path to file. If the file is local this must be a relative path from
     *          // this app.json file.
     파일 경로. 만약 로컬 파일 경로라면 반드시 app.json 파일로 부터 상대경로를 지정해야 한다.
     *          //
     *          "path": "path/to/script.js",   // REQUIRED 필수
     *
     *          // Set to true on one file to indicate that it should become the container
     *          // for the concatenated classes.
     하나의 파일에 연결된 클래스들을 포함하게 하려면 true로 설정한다.
     *          //
     *          "bundle": false,    // OPTIONAL 선택
     *
     *          // Set to true to include this file in the concatenated classes.
     연결된 클래스들 안에 이 파일을 포함시키려면 true로 설정한다.
     *          //
     *          "includeInBundle": false,  // OPTIONAL 선택
     *
     *          // Specify as true if this file is remote and should not be copied into the
     *          // build folder. Defaults to false for a local file which will be copied.
     이 파일이 원격에 있고 build 폴더에 복사되지 않게 하려면 true로 지정한다.
     기본값은 false이다.
     *          //
     *          "remote": false,    // OPTIONAL 선택
     *
     *          // If not specified, this file will only be loaded once, and cached inside
     *          // localStorage until this value is changed. 
     명시하지 않으면, 한번만 로드되고, localStorage에 값이 변경되기 전까지 캐싱된다.
     *          //
     *		// You can specify:
     *          //   - "delta" to enable over-the-air delta update for this file
     *          //   - "full" means full update will be made when this file changes
     이 파일에 대해 델타 업데이트(변경되는 부분적 업데이트)를 활성화 하려면 "delta"를 지정한다.
     이 파일이 변경되면 전체 업데이트를 하도록 "full"을 지정한다.
     *          //
     *          "update": "",        // OPTIONAL 선택
     *
     *          // A value of true indicates that is a development mode only dependency.
     *          // These files will not be copied into the build directory or referenced
     *          // in the generate app.json manifest for the micro loader.
     개발 모드에만 의존하려면 true를 지정한다.
     이 파일들은 마이크로 로더를 위해 build 디렉토리에 복사되거나 생성한 app.json 매니패스트에서 참조되지 않는다.
     *          //
     *          "bootstrap": false   // OPTIONAL 선택
     *      }
     *
     */
    "js": [
        {
            "path": "app.js",
            "bundle": true
        }
    ],

    /**
     * Settings specific to classic toolkit builds.
     classic 툴킷 빌드를 위한 설정
     */
    "classic": {
        "js": [
            // Remove this entry to individually load sources from the framework.
	    // 프레임워크로 부터 독립적으로 자원을 로드하려면 이 엔트리를 삭제하라.
            {
                "path": "${framework.dir}/build/ext-all-debug.js"
            }
        ],
        "locales": [
            "ko",
            "en"
        ],
      "requires": [
        "locale",
        "font-ext",
        "bryntum-scheduler",
        "charts",
        "core"
      ]
    },

    /**
     * Settings specific to modern toolkit builds.
     modern 툴킷 빌드를 위한 설정
     */
    "modern": {
        "js": [
            // Remove this entry to individually load sources from the framework.
	    // 프레임워크로 부터 독립적으로 자원을 로드하려면 이 엔트리를 삭제하라.
            {
                "path": "${framework.dir}/build/ext-modern-all-debug.js"
            }
        ]
    },

    /**
     * List of all CSS assets in the right inclusion order.
     모든 CSS 어셋들의 목록
     *
     * Each item is an object with the following format:
     각 항목은 다음과 같은 형태의 객체이다.
     *
     *      {
     *          // Path to file. If the file is local this must be a relative path from
     *          // this app.json file.
     파일 경로. 만약 로컬 파일 경로라면 반드시 app.json 파일로 부터 상대경로를 지정해야 한다.
     *          //
     *          "path": "path/to/stylesheet.css",   // REQUIRED
     *
     *          // Specify as true if this file is remote and should not be copied into the
     *          // build folder. Defaults to false for a local file which will be copied.
     이 파일이 원격에 있고 build 폴더에 복사되지 않게 하려면 true로 지정한다.
     기본값은 false이다.
     *          //
     *          "remote": false,    // OPTIONAL
     *
     *          // If not specified, this file will only be loaded once, and cached inside
     *          // localStorage until this value is changed. 
     명시하지 않으면, 한번만 로드되고, localStorage에 값이 변경되기 전까지 캐싱된다.
     *          // You can specify:
     *          //
     *          //   - "delta" to enable over-the-air delta update for this file
     *          //   - "full" means full update will be made when this file changes
     이 파일에 대해 델타 업데이트(변경되는 부분적 업데이트)를 활성화 하려면 "delta"를 지정한다.
     이 파일이 변경되면 전체 업데이트를 하도록 "full"을 지정한다.
     *          //
     *          "update": ""      // OPTIONAL
     *      }
     */
    "css": [
        {
            // this entry uses an ant variable that is the calculated
            // value of the generated output css file for the app,
            // defined in .sencha/app/defaults.properties
	    /*
	    이 엔트리는 앱을 위해 생성된 css 파일의 계산된 값인 ant 변수를 사용한다.
	    ant가 참조하는 .sencha/app/defaults.properties 안에 변수가 정의된다.
	    */
            "path": "${build.out.css.path}",
            "bundle": true,
            "exclude": ["fashion"]
        }
    ],

    /**
     * This option is used to configure the dynamic loader. At present these options
     * are supported.
     이 옵션은 동적 로더 설정을 위해 사용된다. 
     현재 이 옵션들은 제공된다.
     *
     */
     "loader": {
         // This property controls how the loader manages caching for requests:
         //
         //   - true: allows requests to receive cached responses
         //   - false: disable cached responses by adding a random "cache buster"
         //   - other: a string (such as the build.timestamp shown here) to allow
         //     requests to be cached for this build.
         //
	 // 이 속성은 로더 매니저가 요청들에 대해 어떻게 캐싱하는지 제어한다.
	 // - true: 캐쉬된 응답을 받기 위한 요청을 허용한다.
	 // - false : 난수 "cache buster"를 추가하여 응답을 캐쉬하지 않는다.
	 // - other: 빌드에 대한 캐싱을 하기 위해 사용되는 문자열.
	 //          (예를들어, build.timestamp)
         "cache": false,

         // When "cache" is not true, this value is the request parameter used
         // to control caching.
	 // "cache"가 true가 아니면, 이 값은 캐싱을 제어하기 위해 요청 파라미터로 사용된다.
         //
         "cacheParam": "_dc"
     },

    /**
     * Settings specific to production builds.
     프로덕션 빌드를 위한 설정
     */
    "production": {
        "output": {
            "appCache": {
                "enable": true,
                "path": "cache.appcache"
            }
        },
        "loader": {
            "cache": "${build.timestamp}"
        },
        "cache": {
            "enable": true
        },
        "compressor": {
            "type": "yui"
        }
    },
    
    /**
     * Settings specific to testing builds.
     testing 빌드를 위한 설정
     */
    "testing": {
    },
    
    /**
     * Settings specific to development builds.
     development 빌드를 위한 설정
     */
    "development": {
        "watch": {
            "delay": 250
        }
    },

    /**
     * Controls the output structure of development-mode (bootstrap) artifacts. May
     * be specified by a string:
     개발 모드의 출력 구조 제어.
     *
     *      "bootstrap": "${app.dir}"
     *
     * This will adjust the base path for all bootstrap objects, or expanded into object
     * form:
     이것은 모든 bootstrap 객체들에 대해 base 경로를 맞추게 되거나 객체의 내부로 확장된다.
     형태:
     *
     *      "bootstrap": {
     *          "base": "${app.dir},
     *          "manifest": "bootstrap.json",
     *          "microloader": "bootstrap.js",
     *          "css": "bootstrap.css"
     *      }
     *
     * You can optionally exclude entries from the manifest. For example, to exclude
     * the "loadOrder" (to help development load approximate a build) you can add:
     선택적으로 manifest로부터 항목들을 제외할 수 있다.
     예를들어, "loadOrder"를 제외하기 위해 "exclude" 속성에 값을 지정한다.
     *
     *      "bootstrap": {
     *          "manifest": {
     *              "path": "bootstrap.json",
     *              "exclude": "loadOrder"
     *          }
     *      }
     *
     */
    "bootstrap": {
        "base": "${app.dir}", 
        "manifest": "${build.id}.json", 
        "microloader": "bootstrap.js",
        "css": "bootstrap.css"
    },

    /**
     * Controls the output directory for build resources.  May be set with
     * either a string:
     자원 빌드를 위한 출력 디렉토리 제어.
     *
     *      "${workspace.build.dir}/${build.environment}/${app.name}"
     *
     * or an object containing values for various types of build artifacts:
     문자열이나 여러 빌드 결과물의 타입을 위한 값들을 포함하는 객체로 설정 가능하다.
     *
     *      {
     *          "base": "${workspace.build.dir}/${build.environment}/${app.name}",
     *          "page": {
     *              "path": "../index.aspx",
     *              "enable": false
     *          },
     *          "css": "${app.output.resources}/${app.name}-all.css",
     *          "js": "app.js",
     *          "microloader": {
     *              "path": "microloader.js",
     *              "embed": true,
     *              "enable": true
     *          },
     *          "manifest": {
     *              "path": "app.json",
     *              "embed": false,
     *              "enable": "${app.output.microloader.enable}"
     *          },
     *          "resources": "resources",
     *          "slicer": {
     *              "path": "${app.output.resources}/images",
     *              "enable": false
     *          },
     *          // Setting the "enable" property of this object to a Truthy value will cause a Application Cache
     *          // manifest file to be generated based on this files appCache object. This file will then be injected
     *          // into the index.html file of the built application
     "enable" 속성값의 설정은 appCache 객체에 기반하여 애플리케이션 캐쉬 manifest 파일을 생성할 것이다.
     이 파일은 빌드된 애플리케이션의 index.html 파일 안에 주입될 것이다.
     *          "appCache":{
     *              "enable": false"
     *          }
     *      }
     *
     */
    
    "output": {
        "base": "${workspace.build.dir}/${build.environment}/${app.name}",
        "page": "index.aspx",
        "manifest": "${build.id}.json",
        "js": "${build.id}/app.js",
        "appCache": {
            "enable": true
        },
        "resources": {
            "path": "${build.id}/resources",
            "shared": "resources"
        }
    },
    
    
    /**
    * Controls for localStorage caching
    localStorage 캐싱 제어
    *   "cache": {
    *       // This property controls whether localStorage caching of this manifest file is on or off.
    *       // if disabled no deltas will be generated during a build and full updates will be disabled
    이 속성은 이 manifest 파일의 캐싱을 켜거나 끄도록 제어한다.
    비활성화하면 빌드하는 동안 deltas는 생성되지 않고 full 업데이트는 비활성화 된다.
    *       "enable": false,
    *
    *       // This property allows for global toggle of deltas.
    이 속성은 deltas의 전역 토글에 대해 허용한다.
    *       // If set to a string the value will be used as the path to where deltas will be generated relative to you build.
    문자열로 설정하면 deltas는 build 경로로 부터 상대경로로 생성된다.
    *       // If set to a Truthy Value the default path ok "deltas" will be used
    Truthy Value로 설정하면 "deltas"의 기본 경로로 사용된다.
    *       // If set to a Falsey value or if this property is not present deltas will be disabled and not generated.
    Falsey 값으로 설정하거나 이 객체 속성이 존재하지 않으면 deltas는 비활성화 되고 생성되지 않는다.
    *
    *       "deltas": "deltas"
    *   }
    */
    
    "cache": {
        "enable": true,
        "deltas": "${build.id}/deltas"
    },
    

    /**
     * Used to automatically generate cache.manifest (HTML 5 application cache manifest)
     * file when you build.
     빌드 할 때 cache.manifest(HTML 5 애플리케이션 캐쉬 manifest)파일을 자동으로 생성하기 위해 사용된다.
     */
    "appCache": {
        /**
         * List of items in the CACHE MANIFEST section
	 CACHE MANIFEST 섹션 목록
         */
        "cache": [
            "index.aspx"
        ],
        /**
         * List of items in the NETWORK section
	 NETWORK 섹션 목록
         */
        "network": [
            "*"
        ],
        /**
         * List of items in the FALLBACK section
	 FALLBACK 섹션 목록
         */
        "fallback": []
    },

    /**
     * Extra resources to be copied into the resource folder as specified in the "resources"
     * property of the "output" object. Folders specified in this list will be deeply copied.
     외부 리소스를 "output"객체의 "resources" 속성에 지정한 폴더로 복제한다.
     목록에 지정된 폴더들은 깊이(deeply) 복제된다.
     */
    "resources": [
        {
            "path": "resources",
            "output": "shared"
        },
        {
            "path": "${toolkit.name}/resources"
        },
        {
            "path": "${build.id}/resources"
        }
    ],

    /**
     * File / directory name patttern to ignore when copying to the builds. Must be a
     * valid regular expression.
     빌드하기 위해 복제할 때 건너뛸 파일/디렉토리 이름 패턴.
     유효한 정규식을 사용해야 한다.
     */
    "ignore": [
        "(^|/)CVS(/?$|/.*?$)"
    ],

    /**
     * Directory path to store all previous production builds. Note that the content
     * generated inside this directory must be kept intact for proper generation of
     * deltas between updates.
     프로덕션 빌드 전에 모두 저장하기 위한 디렉토리 경로.
     이 디렉토리 안에 생성된 컨텐트는 적절한 deltas와 updates의 적절한 생성을 위해 유지되어야 한다.
     */
    
    "archivePath": "archive/${build.id}",
    


