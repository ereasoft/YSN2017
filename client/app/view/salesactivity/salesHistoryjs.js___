Ext.define('Ysn.view.salesactivity.salesHistoryController', {
    extend: 'Ext.app.ViewController',
    alias: 'controller.salesactivity-salesHistory',
	requires: [ 
	    'Ysn.store.*'
    ],
    init: function() {
        this.lookupReference('salesHistorySearch').setTitle(pageTitle);
		if(Ext.getCmp('chkpopup').getValue()){ 
			Ext.getCmp('salesactivitysalesHistory').down('#east').setVisible(false);			
		}else{
			Ext.getCmp('salesactivitysalesHistory').down('#east').setVisible(false);			
		}
	},
	itemclick: function(view, record, index, e) { 
		if(Ext.getCmp('chkpopup').getValue()){
            openPopupView('영업활동현황','salesactivity-salesHistoryDetail',record.get('SA_CD'),'salesHistory|salesHistoryDetail|cust_cd'); 
		}else{
			Ext.getCmp('salesHistoryDetail').load({
				url: '/salesHistory/salesHistoryDetail?cust_cd='+record.get('CUST_CD') //,waitMsg: 'loading...',	
			});
			Ext.getCmp('customrTab').setActiveTab(0);
				Ext.getCmp('customrTab').activeTab.store.load({
								params: {cust_cd: record.get('CUST_CD')}
			});
		}
		//Ext.getCmp('salesactivitysalesHistory').down('#east').show();

		/*Ext.getStore('salesHistoryDetail').load({
			params:{cust_cd:record.get('CUST_CD')},
			callback : function(records, operation, success){ 
				//console.log(records);	//root프로퍼티에 지정된데이터 
			    //console.log(operation.getProxy().getReader().rawData);	//리턴된 json 데이터전체 
				//console.log(success);	//success 프로퍼티에 지정된 데이터 }
				console.log(Ext.getStore('salesHistoryDetail').getAt(0));	//success 프로퍼티에 지정된 데이터 }
                Ext.getCmp('salesHistoryDetail').loadRecord(Ext.getStore('salesHistoryDetail').getAt(0));  
			}
		}); */
	}, 
	onClick: function(){  

		Ext.getCmp('salesHistoryList').saveDocumentAs({ 
            type:       'xlsx',
            title:      Ext.getCmp('salesHistory-search').getTitle(),
            fileName:   '고객사현황.xls' 
		});
	}
});

