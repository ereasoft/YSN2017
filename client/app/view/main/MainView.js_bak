						width: 200,
						labelAlign: 'right',
						displayField: 'YEAR',
						valueField: 'VAL',
						name: 'base_y',
						itemId : 'base_y',
						maskOnDisable: true,
						anchor: '-15',
						store: {
							type: 'year'
						},
						minChars: 0,
						queryMode: 'local',
						margin: '0 5 0 0' 
					},{
						xtype: 'combobox',
						reference: 'base_m',
						publishes: 'value', 
						labelAlign: 'right',
						width: 70,
						displayField: 'MONTH',
						valueField: 'VAL',
						name: 'base_m',
						itemId : 'base_m',
						maskOnDisable: true,
						anchor: '-15',
						store: {
							type: 'month'
						},
						minChars: 0,
						queryMode: 'local',
						margin: '0 10 0 0' 
